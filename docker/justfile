release-primary:
    ARG_TAG_POSTFIX="" ARG_BUILD_EXTRA_ARGS="" just _release-raw

_release-raw:
    #!/bin/bash
    set -euxo pipefail
    cd ..

    VERSION="$(cat docker/version.txt | tr -d '\n')"
    IMAGE_TAG=${VERSION}${ARG_TAG_POSTFIX}

    docker build -f docker/Dockerfile . --build-arg HTTP_PROXY="$http_proxy" --build-arg HTTPS_PROXY="$https_proxy" --build-arg NO_PROXY="localhost,127.0.0.1" $ARG_BUILD_EXTRA_ARGS -t radixark/miles-diffusion:$IMAGE_TAG
    docker push radixark/miles-diffusion:$IMAGE_TAG

    if [ -z "${ARG_TAG_POSTFIX}" ]; then
        docker tag radixark/miles-diffusion:$IMAGE_TAG radixark/miles-diffusion:latest
        docker push radixark/miles-diffusion:latest
    fi

debug:
    #!/bin/bash
    set -euxo pipefail
    cd ..

    VERSION="$(cat docker/version.txt | tr -d '\n')"
    IMAGE_TAG=${VERSION}

    docker build -f docker/Dockerfile . --build-arg HTTP_PROXY="$http_proxy" --build-arg HTTPS_PROXY="$https_proxy" --build-arg NO_PROXY="localhost,127.0.0.1" -t radixark/miles-diffusion-test:$IMAGE_TAG
    docker push radixark/miles-diffusion-test:$IMAGE_TAG

    docker tag radixark/miles-diffusion-test:$IMAGE_TAG radixark/miles-diffusion-test:latest
    docker push radixark/miles-diffusion-test:latest

# Local build only (no push), tag suffixed with -local. Not present in the
# radixark/miles justfile; kept for diffusion local iteration.
build-local:
    #!/bin/bash
    set -euxo pipefail
    cd ..

    VERSION="$(cat docker/version.txt | tr -d '\n')"
    IMAGE_TAG="${VERSION}-local"

    docker build -f docker/Dockerfile . --build-arg HTTP_PROXY="$http_proxy" --build-arg HTTPS_PROXY="$https_proxy" --build-arg NO_PROXY="localhost,127.0.0.1" -t radixark/miles-diffusion:$IMAGE_TAG

# ============================== Experimental CUDA 13 (cu130) ==============================
# Same Dockerfile, only the sglang base image is swapped to a cu130 build via
# SGLANG_IMAGE_TAG. Deliberately NOT wired into release-primary/latest yet —
# these are for validating the CU13 image before it graduates to a real release.
# Version string comes from docker/version-cu13.txt.

SGLANG_IMAGE_TAG_CU13 := "v0.5.14-cu130"

# Local CU13 build only (no push), tag suffixed with -local.
build-local-cu13:
    #!/bin/bash
    set -euxo pipefail
    cd ..

    VERSION="$(cat docker/version-cu13.txt | tr -d '\n')"
    IMAGE_TAG="${VERSION}-local"

    docker build -f docker/Dockerfile . --build-arg SGLANG_IMAGE_TAG={{SGLANG_IMAGE_TAG_CU13}} --build-arg HTTP_PROXY="$http_proxy" --build-arg HTTPS_PROXY="$https_proxy" --build-arg NO_PROXY="localhost,127.0.0.1" -t radixark/miles-diffusion:$IMAGE_TAG

# CU13 build + push to the -test namespace (experimental, shareable).
debug-cu13:
    #!/bin/bash
    set -euxo pipefail
    cd ..

    VERSION="$(cat docker/version-cu13.txt | tr -d '\n')"
    IMAGE_TAG=${VERSION}

    docker build -f docker/Dockerfile . --build-arg SGLANG_IMAGE_TAG={{SGLANG_IMAGE_TAG_CU13}} --build-arg HTTP_PROXY="$http_proxy" --build-arg HTTPS_PROXY="$https_proxy" --build-arg NO_PROXY="localhost,127.0.0.1" -t radixark/miles-diffusion-test:$IMAGE_TAG
    docker push radixark/miles-diffusion-test:$IMAGE_TAG
